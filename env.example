# Environment variables for Jimpitan Application
# This file is for DEVELOPMENT ONLY - DO NOT use these values in production

NODE_ENV=development
DATABASE_URL="file:./data/jimpitan.db"

# AUTH_SECRET must be at least 32 characters 
# In production, generate a secure one using: openssl rand -base64 32
AUTH_SECRET="dev-secret-change-in-production-minimum-32-chars-here-for-testing"

SESSION_EXPIRY_DAYS=7
LOG_LEVEL=debug
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
